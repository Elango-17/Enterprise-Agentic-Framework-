# LLM providers: mock | openai | anthropic | gemini | ollama
LLM_PROVIDER=mock
EXECUTION_LLM_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Ollama
OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434

# Optional framework settings
CHROMADB_PATH=./data/chromadb
EDITOR=auto

# External MCP Server Gateway (Required for document operations, database, Jira, etc.)
MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# ------------------------------------------------------------
# LOGGING / OBSERVABILITY
# ------------------------------------------------------------
# All log files are limited to 10 MB by default.
EAF_LOG_DIR=logs
EAF_LOG_MAX_FILE_BYTES=10485760
EAF_LOG_BACKUP_COUNT=20
EAF_LOG_MAX_VALUE_LENGTH=12000
EAF_CONSOLE_LOG_LEVEL=INFO

# Maximum document size accepted by RAG ingestion (MB)
MAX_RAG_FILE_SIZE_MB=10.0
