# Shared .env for all MCP connectors.
# Fill in your own values — never commit real secrets to source control or
# paste them into a chat.
#
# IMPORTANT: values must be PLAIN strings — no quotes, no brackets, no markdown.
#   GOOD:  JIRA_BASE_URL=https://foo.atlassian.net
#   BAD:   JIRA_BASE_URL='https://foo.atlassian.net'   <- quotes become part of the value
#   BAD:   JIRA_BASE_URL=[https://foo.atlassian.net](https://foo.atlassian.net)
# After editing this file, restart the server — .env is only read at startup.

# --- github.py / github_enterprise.py ------------------------------------
GITHUB_TOKEN=
GITHUB_ENTERPRISE_URL=
GITHUB_ENTERPRISE_TOKEN=

# --- testrail.py ---------------------------------------------------------
TESTRAIL_URL=
TESTRAIL_USER=
TESTRAIL_API_KEY=

# --- postgresql.py -------------------------------------------------------
PG_HOST=
PG_PORT=
PG_DATABASE=
PG_USER=
PG_PASSWORD=

# --- jira.py -------------------------------------------------------------
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- sharepoint.py / onedrive.py -----------------------------------------
# Register an app at https://portal.azure.com -> App registrations
# Grant: Sites.ReadWrite.All (SharePoint), Files.ReadWrite.All (OneDrive)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_SITE_URL=
CONFLUENCE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# --- teams.py ------------------------------------------------------------
# Same Azure app as SharePoint/OneDrive — add ChannelMessage.Send,
# Chat.ReadWrite, Team.ReadBasic.All scopes.
# AZURE_TENANT_ID / AZURE_CLIENT_ID / AZURE_CLIENT_SECRET already above.
TEAMS_USER_ID=

# --- outlook.py ----------------------------------------------------------
# Same Azure app — add Mail.ReadWrite, Mail.Send, Calendars.ReadWrite.
# AZURE_TENANT_ID / AZURE_CLIENT_ID / AZURE_CLIENT_SECRET already above.
OUTLOOK_USER_ID=

# --- files.py (PDF, Word, Excel, CSV, Markdown, PPT, Plain text,
#               Local folders, Windows file system) ------------------------
# No credentials needed — this connector works on local file paths you
# pass as arguments. Set a default root folder to restrict access:
FILES_ROOT_DIR=